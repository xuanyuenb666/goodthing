<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.1" halcon_version="12.0">
<procedure name="main">
<interface/>
<body>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l>dev_update_on ()</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,2]" as_ord="1">list_files ('E:/元创兴资料/Halcon/有关考试/5.芯片测量15/5.芯片测量15/images', ['files','follow_links','recursive'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,3]" as_ord="1">tuple_regexp_select (ImageFiles, ['\\.(tif|tiff|gif|bmp|jpg|jpeg|jp2|png|pcx|pgm|ppm|pbm|xwd|ima|hobj)$','ignore_case'], ImageFiles)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,2]" as_ord="1">for Index := 0 to |ImageFiles| - 1 by 1</l>
<l>            dev_close_window ()</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,3]" as_ord="1">            read_image (Image, ImageFiles[Index])</l>
<l>            get_image_size (Image, Width, Height)</l>
<l>            dev_open_window_fit_size (0, 0, Width, Width, -1, -1, WindowHandle)</l>
<l>            rgb1_to_gray (Image, GrayImage)</l>
<l>            binary_threshold (GrayImage, Region, 'max_separability', 'light', UsedThreshold)</l>
<l>            closing_circle (Region, RegionClosing, 4)</l>
<l>            fill_up (RegionClosing, RegionFillUp)</l>
<l>            connection (RegionFillUp, ConnectedRegions)</l>
<l>            select_shape (ConnectedRegions, SelectedRegions, 'area', 'and', 545109, 1e+006)</l>
<l>            smallest_rectangle2 (SelectedRegions, Row, Column, Phi, Length1, Length2)</l>
<l>            rowCenter := Height/2</l>
<l>            columnCenter := Width/2</l>
<l>            vector_angle_to_rigid (Row, Column, Phi, rowCenter+0.5, columnCenter+0.5, 0, HomMat2D)    </l>
<l>            affine_trans_region (SelectedRegions, RegionAffineTrans, HomMat2D, 'nearest_neighbor')</l>
<l>            affine_trans_image (Image, ImageAffinTrans, HomMat2D, 'constant', 'false')</l>
<l>            closing_rectangle1 (RegionAffineTrans, RegionClosing, Width, Height)</l>
<l>            reduce_domain (ImageAffinTrans, RegionClosing, ImageReduced)</l>
<l>            rgb1_to_gray (ImageReduced, GrayImage1)</l>
<l>            binary_threshold (ImageReduced, GrayImage1, 'max_separability', 'dark', UsedThreshold1)</l>
<l>            closing_circle (GrayImage1, RegionClosing1, 3.5)</l>
<l>            opening_circle (RegionClosing1, RegionOpening, 3.5)</l>
<l>            connection (RegionOpening, ConnectedRegions1)</l>
<l>            select_shape (ConnectedRegions1, SelectedRegions1, 'area', 'and', 2000, 5000)</l>
<l>            sort_region (SelectedRegions1, SortedRegions, 'first_point', 'true', 'column')</l>
<l>            area_center (SortedRegions, Area, Row1, Column1)</l>
<c>            * 判断旋转</c>
<l>            if (Column1[0] &lt; 700)</l>
<l>                         hom_mat2d_identity (HomMat2DIdentity)</l>
<l>                         hom_mat2d_rotate (HomMat2DIdentity, rad(-180), rowCenter+0.5, columnCenter+0.5, HomMat2DRotate)</l>
<l>                         affine_trans_region (RegionAffineTrans, RegionAffineTrans, HomMat2DRotate, 'nearest_neighbor')</l>
<l>                         affine_trans_image (ImageReduced, ImageAffinTrans, HomMat2DRotate, 'constant', 'false')</l>
<l>            endif</l>
<c>            </c>
<l>            rgb1_to_gray (ImageAffinTrans, GrayImage2)</l>
<l>            binary_threshold (GrayImage2, Region1, 'max_separability', 'light', UsedThreshold2)</l>
<l>            connection (Region1, ConnectedRegions2)   </l>
<l>            closing_rectangle1 (ConnectedRegions2, RegionClosing2, Width, Height)</l>
<l>            select_shape (RegionClosing2, SelectedRegions4, 'area', 'and', 404244, 1e+006)</l>
<l>            reduce_domain (GrayImage2, SelectedRegions4, ImageReduced22)            </l>
<l>            binary_threshold (ImageReduced22, GrayImage22, 'max_separability', 'dark', UsedThreshold3)</l>
<l>            closing_circle (GrayImage22, RegionClosing1, 3.5)</l>
<l>            opening_circle (RegionClosing1, RegionOpening, 5)</l>
<l>            connection (RegionOpening, ConnectedRegions1)</l>
<l>            select_shape (ConnectedRegions1, SelectedRegions1, 'area', 'and', 2000, 5000)</l>
<c>            * 提取两个点，求距离</c>
<l>            select_shape (SortedRegions, SelectedRegions2, 'row1', 'and', 845.11, 1000)</l>
<l>            area_center (SelectedRegions2, Area1, Row2, Column2)</l>
<l>            distance_pp (Row2[0], Column2[0], Row2[1], Column2[1], Distance)            </l>
<c>            * 提取右上角的点，求半径</c>
<l>            select_shape (SelectedRegions1, SelectedRegions3, 'area', 'and', 1923.29, 2521.76)            </l>
<l>            opening_circle (SelectedRegions3, RegionOpening1, 18)</l>
<l>            smallest_circle (RegionOpening1, Row3, Column3, Radius)</l>
<c>            * 求两个圆弧拟合的圆                      </c>
<l>            boundary (SelectedRegions4, RegionBorder, 'inner')</l>
<l>            dilation_circle (RegionBorder, RegionDilation, 3.5)</l>
<l>            reduce_domain (GrayImage2, RegionDilation, ImageReduced1)</l>
<l>            edges_sub_pix (ImageReduced1, Edges, 'canny', 1, 20, 40)                        </l>
<l>            segment_contours_xld (Edges, ContoursSplit,\
                                  'lines_circles', 1, 4, 2)</l>
<l>            count_obj (ContoursSplit, Number)</l>
<l>            select_shape_xld (ContoursSplit, SelectedXLD, ['circularity','area'], 'and', [0.0519,200], [0.2,2500])</l>
<c></c>
<l>            union_cocircular_contours_xld (SelectedXLD, UnionContours,\
                               0.5, 0.1, 0.2,\
                               30, 10,\
                               10, 'true', 1)</l>
<l>            fit_circle_contour_xld (UnionContours, 'algebraic',\
                                    -1, 0, 0, 3, 2,\
                                    Row, Column, Radius1,\
                                    StartPhi, EndPhi, PointOrder)</l>
<c>            </c>
<l>            gen_circle_contour_xld (ContCircle1, Row3, Column3, Radius, 0, 6.28318, 'positive', 1)</l>
<l>            gen_circle_contour_xld (ContCircle,\
                                    Row, Column, Radius1,\
                                    0, 6.28318, 'positive', 1)</l>
<l>            gen_cross_contour_xld (Cross, Row, Column, 36, 0)</l>
<l>            gen_cross_contour_xld (Cross1, Row2, Column2, 36, 0)</l>
<l>            gen_cross_contour_xld (Cross2, Row3, Column3, 36, 0)</l>
<l>            gen_contour_polygon_xld (Contour, Row2, Column2)</l>
<l>            union2_closed_contours_xld (ContCircle1, ContCircle, ContoursUnion)</l>
<l>            dev_display (ImageAffinTrans)</l>
<l>            dev_display (ContoursUnion)</l>
<l>            dev_display (Cross)</l>
<l>            dev_display (Cross1)</l>
<l>            dev_display (Cross2)</l>
<l>            dev_display (Contour)</l>
<l>            disp_message (WindowHandle, '这是将工件摆正后的图啊啊啊啊', 'image', 0, 0, 'black', 'true')</l>
<l>            disp_message (WindowHandle, '半径'+Radius, 'image', Row3, Column3, 'black', 'true')</l>
<l>            disp_message (WindowHandle, '半径'+Radius1[0], 'image', Row[0], Column[0], 'black', 'true')</l>
<l>            disp_message (WindowHandle, '半径'+Radius1[1], 'image', Row[1], Column[1], 'black', 'true')</l>
<l>            disp_message (WindowHandle, Distance+'px', 'image', Row2[0], Column2[1]-Column[0]/2, 'blue', 'true')</l>
<c></c>
<c></c>
<c>            </c>
<l>stop()            </l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[3,1]" as_ord="1">endfor</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
